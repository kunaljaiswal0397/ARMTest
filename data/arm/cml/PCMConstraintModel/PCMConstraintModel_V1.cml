// PCMConstraintModel V1 - sample constraint model
// Emits an informational message based on line item count.
// TC-CML: updated in ARMSource and promoted via Stride CLI (2026-11-15)
@(virtual = true)
type PCMSampleModel {
    @(sourceContextNode = "SalesTransaction.SalesTransactionItem")
    relation lineItems : PCMSampleItem[0..100];

    int lineItemCount = [0..100];

    constraint(lineItemCount == lineItems[PCMSampleItem]);

    message(lineItemCount > 2, "PCMConstraintModel V1 (TC-CML via Stride CLI): this quote has %d line items.", lineItemCount, "Info");

    message(lineItemCount > 50, "PCMConstraintModel V1 (TC-CML): more than 50 line items, consider splitting the quote.", "Warning");

}

type PCMSampleItem {
    int quantity = [1..500];

}

type PCMSampleInfoType : PCMSampleModel;

type PCMProduct : PCMSampleModel;
